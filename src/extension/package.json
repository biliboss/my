{
  "name": "my",
  "displayName": "my — os ciclos da casa",
  "description": "Os runs de ~/src/me no Explorer: o que está rodando, quanto falta, e as issues que o ciclo abriu.",
  "version": "0.1.0",
  "private": true,
  "publisher": "biliboss",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "my.runs",
          "name": "my"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "my.runs",
        "contents": "Nenhum run — ou esta janela não vê a casa `~/src/me`.\n[Recarregar](command:my.refresh)\n[Abrir o sandbox](command:my.toggleSandbox)"
      }
    ],
    "commands": [
      {
        "command": "my.refresh",
        "title": "my: Recarregar os runs",
        "icon": "$(refresh)"
      },
      {
        "command": "my.cycleStyle",
        "title": "my: Trocar a representação",
        "icon": "$(symbol-color)"
      },
      {
        "command": "my.toggleSandbox",
        "title": "my: Sandbox de views",
        "icon": "$(beaker)"
      },
      {
        "command": "my.openRun",
        "title": "my: Abrir o run"
      },
      {
        "command": "my.openRunPane",
        "title": "my: Abrir o run num pane",
        "icon": "$(list-tree)"
      },
      {
        "command": "my.openIssues",
        "title": "my: Abrir as issues do run",
        "icon": "$(link-external)"
      },
      {
        "command": "my.openIssue",
        "title": "my: Abrir a issue num pane"
      },
      {
        "command": "my.openPr",
        "title": "my: Abrir o PR"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "my.toggleSandbox",
          "when": "view == my.runs",
          "group": "navigation@0"
        },
        {
          "command": "my.cycleStyle",
          "when": "view == my.runs",
          "group": "navigation@1"
        },
        {
          "command": "my.refresh",
          "when": "view == my.runs",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "my.openRunPane",
          "when": "view == my.runs && viewItem =~ /^run/",
          "group": "navigation"
        },
        {
          "command": "my.openIssues",
          "when": "view == my.runs && viewItem == run.published",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "my",
      "properties": {
        "my.style": {
          "type": "string",
          "enum": [
            "cronometro",
            "progresso",
            "faixa"
          ],
          "enumDescriptions": [
            "12m — o que falta, p50",
            "▓▓▓░░ 7/12 — a posição",
            "8–21m — a faixa p50–p90"
          ],
          "default": "cronometro",
          "description": "Como cada run é desenhado. O botão na toolbar cicla."
        },
        "my.sandbox": {
          "type": "boolean",
          "default": false,
          "description": "Desenha um conjunto FIXO de runs em vez do disco. Serve pra desenhar widget sem depender do que a casa tem hoje."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . && npm run css && npm run assets",
    "watch": "tsc -w -p .",
    "test": "tsc -p . && npm run css && npm run assets && node --test disk/eta.test.mjs disk/plan.test.mjs disk/runs.test.mjs disk/branches.test.mjs disk/commits.test.mjs disk/issues.test.mjs disk/prs.test.mjs gh/api.test.mjs webview/views.test.mjs ui_row_widgets/countdown_timer.test.mjs",
    "css": "tailwindcss -i webview/issue.css -o media/issue.css --minify",
    "assets": "cp node_modules/mermaid/dist/mermaid.min.js media/mermaid.min.js",
    "dev": "node dev/serve.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22",
    "@types/vscode": "^1.100.0",
    "daisyui": "^5.7.17",
    "mermaid": "^11.16.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0"
  }
}

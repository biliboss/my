#!/usr/bin/env bash
# Runs the checks against the files being committed — nothing else.
#
# Versioned here and symlinked into `.git/hooks/pre-commit` by `my system hooks install`, because
# `.git/hooks/` is not versioned: a hook that lives only there dies on the next clone
# and is invisible in the tree. This repo has no package.json and no lefthook, so a
# symlink to a tracked script is the smallest thing that survives.
#
# Three deliberate limits, so this never becomes the hook everyone disables:
#   · STAGED FILES ONLY — a two-file commit does not scan 256 files. Vale pro `okf`
#     também: 0,04s nos markdown do commit contra 0,5s nos 1192 do repo.
#   · ERROR ONLY — a broken contract (field/pointer) blocks; a broken markdown link or
#     a loose mention is reported by `my check all`, never here.
#   · ESCAPE HATCH — `HOOKS=0 git commit` skips it, like every other hook in this house.
#
# O TETO É ~5s, e é o que decide o desenho: a suíte só roda quando o stage tem
# `.ts`, e sem `src/extension/` — medido em 19/08, os `.mjs` de lá são integração
# contra git e disco reais e custam 53 dos 57 segundos, com as 4 falhas do dia
# sendo TIMEOUT deles. Os testes da casa fecham em 3,9s com 0 fail.
#
# depends_on: src/check/citations.ts · src/check/gates.ts · src/check/okf.ts
# depends_on: src/system/hooks/install.ts
# impacts:    src/check/gates.ts
set -uo pipefail

[[ "${HOOKS:-1}" == "0" ]] && exit 0

repo="$(git rev-parse --show-toplevel)"
cd "$repo" || exit 0

# Added/copied/modified/renamed only: a deleted path cannot be scanned, and `-z` plus
# `--diff-filter` keeps a filename with spaces intact.
mapfile -d '' -t staged < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.ts' '*.md' '*.yaml' '*.yml')
[[ ${#staged[@]} -eq 0 ]] && exit 0

existing=()
for f in "${staged[@]}"; do [[ -f "$f" ]] && existing+=("$f"); done
[[ ${#existing[@]} -eq 0 ]] && exit 0

# A project in 01_projects/ may own a gate of its own — its code is its delivery,
# and only it knows what "still correct" means. Found by CONVENTION
# (`01_projects/*/scripts/gate.ts`), never by name: a project's name inside this
# file would outlive the project, and the second project with a gate would be an
# edit to shared infrastructure.
if ! out=$(bun run src/check/gates.ts "${existing[@]}" 2>&1); then
  echo "$out"
  echo
  echo "pre-commit: o gate de um projeto reprovou (acima)."
  echo "  pular: HOOKS=0 git commit …"
  exit 1
fi
[[ -n "${out// }" ]] && echo "$out"

# Ponteiro de run pro vazio: `desenho:`, `origem:`, `serve:`, `projeto:`. Ele varre a
# casa inteira e não só o staged, porque quem quebra um ponteiro é quem MOVE o alvo — e
# quem move nunca está editando o arquivo que aponta. Foi assim que o `desenho:` do 980
# ficou pro vazio por horas em 17/08, com uma seção de view sumindo como único sinal.
if ! out=$(bun run src/check/pointers.ts 2>&1); then
  echo "$out"
  echo "pre-commit: um run aponta pro vazio (acima)."
  echo "  ver tudo:  bun run src/check/pointers.ts"
  exit 1
fi

if ! out=$(bun run src/check/citations.ts "${existing[@]}" 2>&1); then
  echo "$out"
  echo
  echo "pre-commit: a citation in the staged files does not open (see above)."
  echo "  fix it:    bun run src/check/citations.ts --fix --write <file>"
  echo "  or map it: … --fix --write --map old/path.ts=new/path.ts"
  echo "  or skip:   HOOKS=0 git commit …"
  exit 1
fi

# `type:` no frontmatter, SÓ nos markdown deste commit. Varrer os 1192 do repo pra
# julgar dois arquivos leva 0,5s contra 0,04s — e o hook que custa caro é o hook
# que todo mundo desativa. O repo inteiro é problema do `my check all`.
md=()
for f in "${existing[@]}"; do [[ "$f" == *.md ]] && md+=("$f"); done
if [[ ${#md[@]} -gt 0 ]] && ! out=$(bun run src/check/okf.ts "${md[@]}" 2>&1); then
  echo "$out"
  echo
  echo "pre-commit: um markdown deste commit não declara \`type:\` (acima)."
  echo "  consertar: bun run src/check/okf.ts --fix --write"
  echo "  ou pular:  HOOKS=0 git commit …"
  exit 1
fi

# A SUÍTE, e só quando o commit mexe em `.ts`: um commit de conteúdo não pode
# pagar 4s por uma suíte que ele não tem como quebrar.
#
# A lista é explícita, e exclui `src/extension/`. O motivo MUDOU, e o número é o
# que decide — não a promessa antiga de "até a 057 fechar":
#
#   · a 057 fechou, e os 4 timeouts sumiram: `bun test ./src/extension/` dá
#     68 pass · 0 fail. O `scanRuns` caiu de 15,7s pra 2,5s.
#   · mas os testes de lá seguem sendo INTEGRAÇÃO contra o git e o disco reais,
#     custam 4,4s sozinhos contra 1,2s da casa inteira, e crescem a cada run novo
#     do repo. Sob quatro sessões commitando junto, a suíte do hook já levou 40s.
#
# Então eles ficam fora POR CUSTO, não por estarem quebrados, e a extensão tem o
# `npm test` dela. Se um dia deixarem de varrer o disco vivo (é o item (b) da
# 057, que não foi feito), esta linha é onde se reconsidera.
if printf '%s\0' "${existing[@]}" | grep -qz '\.ts$'; then
  mapfile -t suite < <(find src -name '*.test.ts' -not -path 'src/extension/*' -not -path '*/node_modules/*')
  if ! out=$(bun test "${suite[@]}" 2>&1); then
    echo "$out" | tail -25
    echo
    echo "pre-commit: a suíte da casa reprovou (acima)."
    echo "  rodar:    bun test \$(find src -name '*.test.ts' -not -path 'src/extension/*')"
    echo "  ou pular: HOOKS=0 git commit …"
    exit 1
  fi
fi
exit 0

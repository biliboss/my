[
	{
		"createSurface": {
			"surfaceId": "exec-{{feature}}",
			"title": "{{projeto}} · {{feature}} — o contrato e o que o agente está fazendo com ele",
			"columns": 1,
			"x": 0,
			"y": 6
		}
	},
	{
		"updateDataModel": {
			"surfaceId": "exec-{{feature}}",
			"contents": {
				"feature": "{{feature}}",
				"projeto": "{{projeto}}",
				"label": "{{label}}",
				"estado": "{{estado}}",
				"subiu_em": "{{subiu_em}}",
				"abertas": "{{abertas}}",
				"barra": "{{barra}}",
				"previsao": "{{previsao}}",
				"espera": [
					"{{espera_1}}",
					"{{espera_2}}",
					"{{espera_3}}"
				],
				"ids": [
					"{{pane}}",
					"{{session_id}}",
					"{{transcript}}"
				]
			}
		}
	},
	{
		"updateComponents": {
			"surfaceId": "exec-{{feature}}",
			"components": [
				{
					"id": "cab",
					"column": 0,
					"componentProperties": {
						"Heading": {
							"text": "{{projeto}} · {{feature}}"
						}
					}
				},
				{
					"id": "hud",
					"column": 0,
					"usa": "hud_agente@1"
				},
				{
					"id": "split",
					"style": {
						"flex": "1",
						"min-height": "0",
						"display": "grid",
						"grid-template-columns": "repeat(auto-fit, minmax(24rem, 1fr))",
						"gap": "0.75rem"
					},
					"componentProperties": {
						"Box": {}
					},
					"children": [
						{
							"id": "contrato",
							"style": {
								"min-width": "0",
								"min-height": "0",
								"overflow": "hidden"
							},
							"componentProperties": {
								"Tabs": {
									"items": [
										{
											"label": "o que É",
											"src": "/doc/01_projects/{{projeto}}/features/{{feature}}/CONTEXT.md"
										},
										{
											"label": "tasks",
											"src": "/doc/01_projects/{{projeto}}/features/{{feature}}/tasks.md"
										},
										{
											"label": "o projeto",
											"src": "/doc/01_projects/{{projeto}}/{{projeto}}.md"
										}
									]
								}
							}
						},
						{
							"id": "execucao",
							"style": {
								"min-width": "0",
								"min-height": "0",
								"overflow": "hidden"
							},
							"componentProperties": {
								"Tabs": {
									"items": [
										{
											"label": "🏃 o run",
											"src": "/doc/_step_runs/{{run}}"
										},
										{
											"label": "o pedido",
											"src": "/doc/_step_runs/{{run}}/input.yaml"
										},
										{
											"label": "o brief",
											"src": "/doc/_step_runs/{{run}}/{{brief}}"
										}
									]
								}
							}
						}
					]
				},
				{
					"id": "h-espera",
					"column": 0,
					"componentProperties": {
						"Heading": {
							"text": "o que prova que terminou"
						}
					}
				},
				{
					"id": "tasks-espera",
					"column": 0,
					"componentProperties": {
						"Tasks": {
							"items": {
								"path": "espera"
							}
						}
					}
				},
				{
					"id": "ids",
					"column": 0,
					"usa": "ids_do_agente@1"
				}
			]
		}
	}
]

{
  "name": "@biliboss/herdr",
  "version": "0.1.0",
  "description": "The multiplexer where the fleet lives: workspaces, tabs, panes and agents, over the one shellout that carries the timeout and --remote.",
  "license": "MIT",
  "author": "Gabriel (biliboss)",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./run": "./run.ts",
    "./policy": "./policy.ts",
    "./agents/*": "./agents/*.ts",
    "./panes/*": "./panes/*.ts",
    "./tabs/*": "./tabs/*.ts",
    "./workspaces/*": "./workspaces/*.ts"
  },
  "dependencies": {
    "@biliboss/interfaces": "workspace:*",
    "@biliboss/shared": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20",
    "typescript": "catalog:"
  },
  "scripts": {
    "check": "tsc --noEmit --strict --target es2022 --module esnext --moduleResolution bundler --allowImportingTsExtensions --skipLibCheck --types node,bun *.ts */*.ts"
  }
}
